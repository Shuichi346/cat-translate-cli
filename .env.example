# Copy this file to .env and edit values as needed.

# Web UI
CAT_TRANSLATE_WEB_HOST=127.0.0.1
CAT_TRANSLATE_WEB_PORT=3000

# Python translation backend
CAT_TRANSLATE_SERVER_HOST=127.0.0.1
CAT_TRANSLATE_SERVER_PORT=7860

# Model selection
CAT_TRANSLATE_REPO_ID=mradermacher/CAT-Translate-7b-i1-GGUF

# Choose one model filename from the Hugging Face repo:
# CAT-Translate-7b.i1-Q4_K_M.gguf
# CAT-Translate-7b.i1-Q6_K.gguf
CAT_TRANSLATE_MODEL=CAT-Translate-7b.i1-Q6_K.gguf

# Optional: use a local GGUF file instead of downloading from the repo.
# CAT_TRANSLATE_MODEL_PATH=/absolute/path/to/CAT-Translate-7b.i1-Q6_K.gguf

# Runtime tuning
CAT_TRANSLATE_N_GPU_LAYERS=-1
CAT_TRANSLATE_N_CTX=4096
CAT_TRANSLATE_MAX_TOKENS=2048
